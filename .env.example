# Copiar a .env.local y completar con los valores de `supabase status`.
# Ninguna clave real vive en este archivo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO SERVIDOR: se usa en el seed y en tareas de sistema.
# Nunca con prefijo NEXT_PUBLIC_, nunca versionada (PRD decisión 9).
SUPABASE_SECRET_KEY=

# Contraseña de los usuarios de prueba de la semilla (PRD §13.4).
SEED_PASSWORD=

# URL pública de la app. Se usa para armar el link absoluto de las
# invitaciones (`/auth/confirm?inv=...`) que manda Supabase por email.
SITE_URL=http://localhost:3000

# Sin IA en este producto: ninguna clave de modelo va acá (PRD §16).
